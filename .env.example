# Copy to .env and fill in. Never commit .env.
# Variables already set in the process environment take precedence.

# SQLite store. Created on first use.
AINGRAM_DB=./aingram.db

# The admin wallet: the only account that can sign in at /admin, and the
# only authority for changes (every change is signed by this wallet).
AINGRAM_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Public HTTPS URL clients connect to (no trailing slash). Plain http is
# accepted only for localhost, for local development.
AINGRAM_PUBLIC_URL=https://aingram.example.com

# Where the server listens. Keep it on loopback behind a TLS reverse proxy.
AINGRAM_HOST=127.0.0.1
AINGRAM_PORT=8787

# Optional. The first policy draft the admin page offers before any policy is
# approved. Defaults to policy.example.yaml. After the first approval the
# policy lives in the database and is edited on the admin page.
# AINGRAM_POLICY=./policy.yaml

# Optional. The only redirect URIs an OAuth client (the brain's connector)
# may register, comma-separated. Defaults to Claude's connector callback on
# claude.ai and claude.com.
# AINGRAM_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Optional. Name bound into every signed admin command. Defaults to the host
# of AINGRAM_PUBLIC_URL. Changing it later means approving the policy again.
# AINGRAM_SERVER_NAME=aingram.example.com
