# Copy to .env and fill in. Never commit .env.
# Variables already set in the process environment take precedence.

# SQLite store. Created on first use.
AINGRAM_DB=./aingram.db

# Policy file (copy policy.example.yaml). Its exact bytes must be approved
# with a signed `aingram_admin.py policy reload` before the server will load it.
AINGRAM_POLICY=./policy.yaml

# Name bound into every signed admin command. Use your public hostname.
AINGRAM_SERVER_NAME=aingram.example.com

# The admin wallet: the only authority for admin commands.
AINGRAM_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Public HTTPS URL clients connect to (no trailing slash). Plain http is
# accepted only for localhost, for local development.
AINGRAM_PUBLIC_URL=https://aingram.example.com

# Where the server listens. Keep it on loopback behind a TLS reverse proxy.
AINGRAM_HOST=127.0.0.1
AINGRAM_PORT=8787
